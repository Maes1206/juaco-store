POSTGRES_DB=juaco_store
POSTGRES_USER=juaco
POSTGRES_PASSWORD=CAMBIA_POR_UNA_CLAVE_LARGA_Y_UNICA
POSTGRES_PORT=5432
POSTGRES_HOST=db
DJANGO_SECRET_KEY=CAMBIA_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES
# Deja 0 siempre. Con 1 el sitio publica trazas, codigo fuente y el mapa de rutas.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
WEB_PORT=8000

# Bloqueo de inicio de sesión tras contraseñas incorrectas repetidas (django-axes).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Correo transaccional para recuperar contraseñas. Usa las credenciales SMTP
# de tu proveedor en producción. En desarrollo directo, si omites
# DJANGO_EMAIL_BACKEND, Django imprime el mensaje en la consola.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Nexus Luxury Footwear <no-reply@tudominio.com>
PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Correos autorizados para solicitar una cuenta administrativa. La promoción
# solo ocurre después de confirmar el enlace enviado al correo indicado.
ADMIN_REGISTRATION_EMAILS=

# StockX (opcional): activa el autocompletado híbrido del lanzamiento.
STOCKX_API_KEY=
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_REFRESH_TOKEN=
# Útil para pruebas; expira aproximadamente cada 12 horas. En producción usa REFRESH_TOKEN.
STOCKX_ACCESS_TOKEN=
STOCKX_TIMEOUT_SECONDS=5

# Pasarela de pagos Bold. Copia las llaves desde bold.co > Integraciones.
# Si quedan vacías, el checkout no ofrece "Pago con Bold".
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
# Solo muestra el aviso "modo de pruebas" en el checkout. 1 con llaves de prueba.
BOLD_TEST_MODE=0
# Acepta webhooks firmados con llave vacía, como hace el sandbox de Bold. Es lo
# mismo que no validar la firma: con esto en 1 cualquiera puede marcar un pedido
# como pagado. Solo para desarrollo; el servidor se niega a arrancar si lo
# activas sin DJANGO_DEBUG=1.
BOLD_ALLOW_UNSIGNED_WEBHOOKS=0
# Dominio HTTPS público con el que Bold devuelve al comprador y envía el webhook.
# Vacío en local: el pago se confirma consultando la API con "Verificar pago".
BOLD_PUBLIC_BASE_URL=
PUBLIC_SITE_URL=
BOLD_TIMEOUT_SECONDS=10
